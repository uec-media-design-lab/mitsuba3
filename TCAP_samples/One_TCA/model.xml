<scene version="2.1.0">



    <default name="spp" value="4096" />
    <default name="resx" value="500" />
    <default name="resy" value="500" />

    
    <default name="tcylinder_ior" value="1.5" />     
    <default name="tcylinder_alpha" value="0.001" /> 
    <default name="tcylinder_d" value="1.0" />       
    <default name="tcylinder_h" value="1" />      
    <default name="tcylinder_theta" value="30" />    

    
    <default name="tcylinder_half_h" value="0.5" />                 
    <default name="tcylinder_ends_h" value="0.5773502691896257" />                 
    <default name="tcylinder_ends_ellipse_l" value="0.5773502691896257" />         
    <default name="tcylinder_ends_ellipse_center_h" value="0.7886751345948129" />  



    <integrator type="path">
        <integer name="max_depth" value="-1" />
    </integrator>


    <bsdf type="roughdielectric" id="mat-rough_dielectric">
        <string name="distribution" value="beckmann" />
        <float name="alpha" value="$tcylinder_alpha" />
        <float name="int_ior" value="$tcylinder_ior" />
        <string name="ext_ior" value="air" />
    </bsdf>

    <bsdf type="conductor" id="mat-Mirror">
		<string name="material" value="Ag" />
	</bsdf>

    <bsdf type="twosided" id="mat-twosided_checkerboard">
        <bsdf type="diffuse">
            <texture name="reflectance" type="checkerboard">
                <transform name="to_uv">
                    <scale x="4" y="4" />
                </transform>
            </texture>
        </bsdf>
    </bsdf>



    <emitter type="area" id="mat-displayed_image">
        <texture name="radiance" type="bitmap">
            <string name="filename" value="../koume.jpg" />
        </texture>
    </emitter>

    <emitter type="constant">
        <spectrum name="radiance" value="0.1" />
    </emitter>




    
    <shape type="shapegroup" id="truncatedcylinder">
        <!-- 上側の断面 -->
        <shape type="disk">
            <ref id="mat-twosided_checkerboard" />
            <transform name="to_world">
                <scale x="0.5" y="$tcylinder_ends_ellipse_l" z="0.5" />
                <rotate x="1" angle="-90" />
                <rotate x="1" angle="$tcylinder_theta" />
                <translate x="0" y="$tcylinder_ends_ellipse_center_h" z="0" />
            </transform>
        </shape>
        
        <!-- 上側の斜切り円柱 -->
        <shape type="mytruncatedcylinder">
            <ref id="mat-rough_dielectric" />
            <float name="radius" value="0.5" />
            <point name="p0" x="0" y="0" z="0" />
            <point name="p1" x="0" y="$tcylinder_ends_h" z="0" />
            <transform name="to_world">
                <scale value="0.99" />
                <rotate y="1" angle="90" />
                <translate x="0" y="$tcylinder_half_h" z="0" />
            </transform>
        </shape>

        <!-- 中央の円柱 -->
        <shape type="cylinder">
            <ref id="mat-rough_dielectric" />
            <float name="radius" value="0.5" />
            <point name="p0" x="0" y="-$tcylinder_half_h" z="0" />
            <point name="p1" x="0" y="$tcylinder_half_h" z="0" />
            <transform name="to_world">
                <scale value="0.99" />
                <translate x="0" y="0" z="0" />
            </transform>
        </shape>
        
        <!-- 中央の鏡面 -->
        <!--
        <shape type="myhalfcylinder">
            <ref id="mat-Mirror" />
            <float name="radius" value="0.5" />
            <point name="p0" x="0" y="-$tcylinder_half_h" z="0" />
            <point name="p1" x="0" y="$tcylinder_half_h" z="0" />
            <boolean name="flip_normals" value="true" />
            <transform name="to_world">
                <scale value="1" />
                <rotate y="1" angle="-90" />
                <translate x="0" y="0" z="0" />
            </transform>
        </shape>
        -->
        
        <!-- 下側の斜切り円柱 -->
        <shape type="mytruncatedcylinder">
            <ref id="mat-rough_dielectric" />
            <float name="radius" value="0.5" />
            <point name="p0" x="0" y="0" z="0" />
            <point name="p1" x="0" y="-$tcylinder_ends_h" z="0" />
            <transform name="to_world">
                <scale value="0.99" />
                <rotate y="1" angle="90" />
                <translate x="0" y="-$tcylinder_half_h" z="0" />
            </transform>
        </shape>

        <!-- 下側の断面 -->
        <shape type="disk">
            <ref id="mat-twosided_checkerboard" />
            <transform name="to_world">
                <scale x="0.5" y="$tcylinder_ends_ellipse_l" z="0.5" />
                <rotate x="1" angle="-90" />
                <rotate x="1" angle="-$tcylinder_theta" />
                <translate x="0" y="-$tcylinder_ends_ellipse_center_h" z="0" />
            </transform>
        </shape>

    </shape>


    <!-- 光源 -->
    <shape type="rectangle" id="shape-display">
        <ref id="mat-displayed_image" />
        <boolean name="flip_normals" value="false" />
        <transform name="to_world">
            <scale x="3" y="3" />
            <rotate x="1" angle="180" />
            <rotate y="1" angle="90" />
            <translate x="0" y="0" z="0" />
        </transform>
    </shape>

    

<shape type="instance">
    <ref id="truncatedcylinder" />
    <transform name="to_world">
        <translate x="-3.0" y="0" z="0.0" />
        <scale value="1.0" />
    </transform>
</shape>

</scene>